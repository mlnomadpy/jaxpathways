---
import { currentRelease } from '../../lib/releases.js';
import { siteUrl } from '../../lib/urls.js';
---

<aside
  class="release-notice"
  id="release-notice"
  data-version={currentRelease.version}
  hidden
  aria-label="Course update"
>
  <p>
    <strong>New in the book: v{currentRelease.version}.</strong> {currentRelease.notes.title}.
    <a href={siteUrl('updates.html')}>See what changed</a>
  </p>
  <button type="button" id="dismiss-release">
    Dismiss update notice
  </button>
</aside>
<script>
  import { initReleaseNotice, initRevisionNotices } from '../../scripts/release-notices.js';
  initReleaseNotice();
  initRevisionNotices();
</script>
