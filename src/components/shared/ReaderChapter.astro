---
import { materialStatus, materialStatusLabel } from '../../lib/material-status.js';
import { inlineMath, renderMath } from '../../lib/math.js';
import { executionScope } from '../../lib/runtime.js';
import Prose from './Prose.astro';
import {
  renderBuildStepCodeBreakdown,
  renderLearnerStarterContract,
} from '../../lib/code-teaching.js';
import { codePanel as sharedCodePanel } from '../../lib/lesson-content.js';
import { lessonVisual, lessonExecution, lessonMechanism } from '../../lib/lesson-visuals.js';
import { embeddedImage } from '../../lib/server/reader-assets.js';
import { authoredLessons } from '../../lib/course-data.js';
interface Props {
  lesson: (typeof authoredLessons)[number];
  index: number;
  offline?: boolean;
}
const { lesson, index } = Astro.props;
const c = lesson.content!;
const preparation = lesson.prerequisites.map((id) => {
  const position = authoredLessons.findIndex((item) => item.id === id);
  return { id, position, title: authoredLessons[position]?.title || id };
});
const scope = executionScope(lesson);
const maturity = materialStatus('lessons', lesson.id);
const statusUrl = new URL(
  `content-status.html#lessons-${lesson.id}`,
  'https://www.tahabouhsine.com/jaxpathways/',
).href;
const codePanel = (source: string, label: string) =>
  sharedCodePanel(source, label).replace(
    '<pre ',
    '<pre tabindex="0" aria-label="Scrollable code" ',
  );
const { offline = false } = Astro.props;
---

<article id={`chapter-${index}`}>
  <p class="chapter-kicker">
    Chapter {index + 1} · {lesson.id}
  </p>
  <h1>{lesson.title}</h1>
  <p class="chapter-kicker">
    <a href={statusUrl}>{materialStatusLabel(maturity.level)}</a> · {maturity.review}. Applies to
    this chapter and its practice tasks.
  </p>
  <p set:html={inlineMath(lesson.objective)} />
  {preparation.length > 0 && (
    <nav class="chapter-preparation" aria-label="Chapter preparation">
      <strong>Before this chapter:</strong>{' '}
      {preparation.map((item, i) => (
        <Fragment>
          {i > 0 && '; '}
          <a href={`#chapter-${item.position}`}>{item.title}</a>
        </Fragment>
      ))}
    </nav>
  )}
  {c.setupBundle && (
    <p>
      <a href={new URL(c.setupBundle.url, 'https://www.tahabouhsine.com/jaxpathways/').href}>
        {c.setupBundle.title}
      </a>
      . Extract the archive and work in its <code>jax-start-here</code> folder. The setup
      instructions below refer to <code>first_experiment.py</code> in that folder.
    </p>
  )}
  <aside class="runtime-note">
    <p>{scope.description}</p>
    <p>{scope.target}</p>
  </aside>
  {c.objectives && (
    <>
      <h2>What you will be able to do</h2>
      <ul>
        {c.objectives.map((o) => (
          <li set:html={inlineMath(o)} />
        ))}
      </ul>
    </>
  )}
  {c.problem && (
    <>
      <h2>The problem</h2>
      <Prose text={c.problem} />
    </>
  )}
  <h2>The idea</h2>
  <Prose text={c.idea} />
  {c.sections?.map((section) => (
    <>
      <h2 set:html={inlineMath(section.title)} />
      <Prose text={section.body} />
      {section.id === 'guided-reasoning' && (
        <Fragment set:html={lessonMechanism(lesson, { offline, imageResolver: embeddedImage })} />
      )}
      {section.check && (
        <aside class="reasoning-check">
          <h3>Pause and reason</h3>
          <Prose text={section.check.prompt} />
          <details>
            <summary>Compare your reasoning</summary>
            <Prose text={section.check.answer} />
          </details>
        </aside>
      )}
      {section.commands?.map((command) => (
        <>
          <h3 set:html={inlineMath(command.label)} />
          <Fragment set:html={codePanel(command.code, command.shell || 'Terminal')} />
          <p>
            <strong>Expected:</strong>
          </p>
          <Prose text={command.expected} />
        </>
      ))}
      <Fragment set:html={section.math ? renderMath(section.math, true) : ''} />
      {section.formula && <pre
        class="shape-sketch"
        aria-label="Shape or computation sketch"
      ><code>{section.formula}</code></pre>}
    </>
  ))}
  <Fragment set:html={lessonVisual(lesson, { offline, imageResolver: embeddedImage })} />
  {c.buildSteps?.map((step) => (
    <>
      <h2 set:html={inlineMath(step.title)} />
      <Prose text={step.instruction} />
      <Fragment set:html={renderBuildStepCodeBreakdown(step.code)} />
      <Fragment set:html={codePanel(step.code, 'Python · build step')} />
      <Prose text={step.explanation} />
    </>
  ))}
  {c.buildCode && (
    <>
      <h2>Build a numerical estimate</h2>
      <details class="solution-reveal">
        <summary>Reveal the complete numerical estimate code</summary>
        <Fragment set:html={codePanel(c.buildCode, 'Python · numerical estimate')} />
      </details>
      <Prose text={c.buildOutput} />
    </>
  )}
  <h2>Run the example</h2>
  <details class="solution-reveal">
    <summary>Reveal the assembled example code</summary>
    <Fragment set:html={codePanel(c.code, 'Python · complete example')} />
  </details>
  <div class="expected-output">
    <p class="output-label">Expected result</p>
    <Prose text={c.output} />
  </div>
  <Fragment set:html={lessonExecution(lesson)} />
  {c.experiments?.map((experiment) => (
    <>
      <h2 set:html={inlineMath(experiment.title)} />
      <p>
        <strong>Predict before running:</strong>{' '}
        <span set:html={inlineMath(experiment.prediction)} />
      </p>
      <Fragment set:html={codePanel(experiment.code, 'Python · experiment')} />
      <div class="expected-output">
        <p class="output-label">Expected result</p>
        <Prose text={experiment.output} />
      </div>
      <Prose text={experiment.explanation} />
    </>
  ))}
  <h2>Your exercise</h2>
  <Prose text={c.exercise} />
  <Fragment set:html={renderLearnerStarterContract(c.learnerStarter, 'Exercise learner starter')} />
  <p class="print-solution-link">
    <a href={`#chapter-${index}-print-solutions`}>Printed reference solutions and reasoning</a>
  </p>
  <details class="solution-reveal">
    <summary>Reveal the reference solution</summary>
    <Fragment set:html={codePanel(c.solution, 'Python · reference solution')} />
  </details>
  {c.practice?.map((practice) => (
    <>
      <h2 set:html={inlineMath(practice.title)} />
      <p>{practice.difficulty}</p>
      <Prose text={practice.prompt} />
      <h3>Hint</h3>
      <Prose text={practice.hint} />
      <Fragment
        set:html={renderLearnerStarterContract(
          practice.learnerStarter,
          `${practice.title} learner starter`,
        )}
      />
      <p class="print-solution-link">
        <a href={`#chapter-${index}-print-solutions`}>Printed reference solutions and reasoning</a>
      </p>
      <details class="solution-reveal">
        <summary>Reveal the reference solution</summary>
        <Fragment set:html={codePanel(practice.solution, 'Python · practice solution')} />
        <Prose text={practice.explanation} />
      </details>
    </>
  ))}
  <h2>Checkpoint</h2>
  <Prose text={c.question} />
  <ol>
    {c.options.map((option) => (
      <li set:html={inlineMath(option)} />
    ))}
  </ol>
  <details class="solution-reveal">
    <summary>Reveal the checkpoint answer and explanation</summary>
    <p>
      <span set:html={inlineMath(`Answer: ${c.options[c.answer]}. ${c.explanation}`)} />
    </p>
    <h3>Reason through the other choices</h3>
    <ul>
      {c.options.map(
        (option, index) =>
          index !== c.answer && (
            <li>
              <strong set:html={inlineMath(option)} />
              <Prose text={c.optionFeedback[index]} />
            </li>
          ),
      )}
    </ul>
  </details>
  <p class="print-solution-link">
    <a href={`#chapter-${index}-print-solutions`}>Printed checkpoint answer and reasoning</a>
  </p>
  {c.diagnosis && (
    <>
      <h2>Diagnose the result</h2>
      <Prose text={c.diagnosis} />
    </>
  )}
  {c.takeaways && (
    <>
      <h2>Carry forward</h2>
      <ul>
        {c.takeaways.map((takeaway) => (
          <li set:html={inlineMath(takeaway)} />
        ))}
      </ul>
    </>
  )}
  <h2>Your evidence</h2>
  <Prose text={lesson.evidence} />
  {c.references && (
    <>
      <h2>Primary references</h2>
      <ul>
        {c.references.map((reference) => (
          <li>
            <a href={reference.url}>{reference.title}</a>
          </li>
        ))}
      </ul>
    </>
  )}
  <section
    class="print-solutions"
    id={`chapter-${index}-print-solutions`}
    aria-label="Printed reference solutions and reasoning"
  >
    <p class="chapter-kicker">
      Chapter {index + 1} · {lesson.id}
    </p>
    <h2>{lesson.title}: reference solutions and checkpoint reasoning</h2>
    {c.buildCode && (
      <>
        <h3>Numerical estimate code</h3>
        <Fragment set:html={codePanel(c.buildCode, 'Python · numerical estimate')} />
      </>
    )}
    <h3>Assembled example code</h3>
    <Fragment set:html={codePanel(c.code, 'Python · complete example')} />
    <h3>Exercise solution</h3>
    <Fragment set:html={codePanel(c.solution, 'Python · reference solution')} />
    {c.practice?.map((practice) => (
      <section class="printed-practice-solution">
        <h3>{practice.title} · reference solution</h3>
        <Fragment set:html={codePanel(practice.solution, 'Python · practice solution')} />
        <Prose text={practice.explanation} />
      </section>
    ))}
    <section class="printed-checkpoint-reasoning">
      <h3>Checkpoint answer and explanation</h3>
      <p>
        <span set:html={inlineMath(`Answer: ${c.options[c.answer]}. ${c.explanation}`)} />
      </p>
      <h4>Reason through the other choices</h4>
      <ul>
        {c.options.map(
          (option, optionIndex) =>
            optionIndex !== c.answer && (
              <li>
                <strong set:html={inlineMath(option)} />
                <Prose text={c.optionFeedback[optionIndex]} />
              </li>
            ),
        )}
      </ul>
    </section>
  </section>
</article>
