---
import repository from '../../data/repository.json';
interface Props {
  prominent?: boolean;
}
const { prominent = false } = Astro.props;
---

<a
  class:list={['github-link', { 'github-link-prominent': prominent }]}
  href={repository.url}
  data-github-link
  title={`GitHub repository · ${repository.stars} stars, checked ${repository.checkedOn}`}
>
  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12 .75a11.25 11.25 0 0 0-3.558 21.923c.563.104.77-.244.77-.542 0-.267-.01-.975-.015-1.914-3.13.68-3.79-1.509-3.79-1.509-.512-1.3-1.25-1.646-1.25-1.646-1.022-.699.077-.685.077-.685 1.13.08 1.725 1.16 1.725 1.16 1.005 1.723 2.637 1.225 3.279.937.102-.728.393-1.225.715-1.507-2.498-.284-5.124-1.249-5.124-5.562 0-1.229.439-2.234 1.159-3.021-.116-.285-.502-1.429.11-2.978 0 0 .945-.302 3.094 1.154A10.78 10.78 0 0 1 12 6.191c.956.004 1.919.13 2.818.379 2.148-1.456 3.091-1.154 3.091-1.154.614 1.549.228 2.693.112 2.978.721.787 1.158 1.792 1.158 3.021 0 4.324-2.63 5.275-5.136 5.554.404.35.765 1.04.765 2.097 0 1.514-.014 2.736-.014 3.107 0 .301.203.652.774.541A11.25 11.25 0 0 0 12 .75Z" />
  </svg>
  <span>{prominent ? 'Star on GitHub' : 'GitHub'}</span>
  <span class="github-stars">
    <span aria-hidden="true">☆</span>
    <span data-github-stars>{repository.stars.toLocaleString('en-US')}</span>
    <span class="github-sr-only">stars</span>
  </span>
</a>

<script>
  import { refreshGitHubStars } from '../../scripts/github-stars.js';
  void refreshGitHubStars();
</script>

<style>
  .github-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    white-space: nowrap;
    font: 600 14px/1.2 var(--ui);
    text-decoration: none;
  }
  .github-stars {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 7px;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-variant-numeric: tabular-nums;
  }
  .github-link-prominent {
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper);
    color: var(--ink);
  }
  .github-link:hover {
    color: var(--atlas);
  }
  .github-link:focus-visible {
    outline: 2px solid var(--atlas);
    outline-offset: 4px;
  }
  .github-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
