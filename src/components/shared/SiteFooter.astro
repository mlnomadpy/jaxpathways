---
import { currentRelease, feedbackUrl, feedbackAccess } from '../../lib/releases.js';
import { siteUrl } from '../../lib/urls.js';
---

<footer>
  <a class="brand" href={siteUrl('index.html')}>
    JAX Pathways
  </a>
  <p>
    Independent course by Taha Bouhsine.{' '}
    <a href={siteUrl('updates.html')}>Version {currentRelease.version} · What changed</a>
  </p>
  <nav aria-label="Footer">
    <a href="https://github.com/mlnomadpy/jaxpathways">Source</a>
    <a href={feedbackUrl()}>Give feedback</a>
    <a href="https://docs.jax.dev/">JAX docs</a>
  </nav>
  <p>Found an error or a confusing explanation? Open a GitHub issue to help improve the book.</p>
  {feedbackAccess && <p>{feedbackAccess}</p>}
  <p class="credit">
    Design inspiration:{' '}
    <a href="https://aiengineeringfromscratch.com/">AI Engineering from Scratch</a>.
  </p>
</footer>

<style>
  footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 24px;
    padding-block: 40px;
    color: var(--muted);
    font: 14px/1.6 var(--ui);
  }
  footer .brand {
    font: 700 20px/1.3 var(--ui);
    color: var(--atlas);
    letter-spacing: -0.04em;
  }
  footer .brand::before {
    content: none;
  }
  footer p {
    margin: 0;
  }
  footer nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  footer a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  footer nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  footer .brand {
    text-decoration: none;
  }
  footer .credit {
    flex-basis: 100%;
    font-size: 12px;
  }
  @media (max-width: 760px) {
    footer {
      gap: 12px;
    }
    footer nav {
      flex-basis: 100%;
    }
  }
</style>
