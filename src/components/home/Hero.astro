---
import '../../styles/home/hero.css';
import copy from '../../data/home.json';
import { siteUrl } from '../../lib/urls.js';
import GitHubLink from '../shared/GitHubLink.astro';
import TutorStart from './TutorStart.astro';
import { course, inventory } from '../../lib/course-data.js';
---

<section class="hero" aria-labelledby="home-title">
  <p class="hero-scope">
    <a href={siteUrl('course.html')}>{inventory.authored} available lessons</a>
    <span>{course.phases.length} phases</span>
    <a href={siteUrl('projects.html')}>{inventory.projects} hands-on projects</a>
  </p>
  <div class="hero-copy">
    <h1 id="home-title">
      {copy.hero.title.map((line, index) => (
        <>
          {index > 0 && <br />}
          {line}
        </>
      ))}
    </h1>
    <p class="intro">{copy.hero.intro}</p>
    <p class="hero-byline">
      Created by <strong>{copy.hero.author}</strong>. Run on your own machine.
    </p>
    <p class="hero-note">{copy.hero.note}</p>
  </div>

  <div class="hero-actions actions">
    {copy.hero.actions.map((action, index) => (
      <a class:list={['button', { primary: index === 0 }]} href={siteUrl(action.href)}>
        {action.label}
      </a>
    ))}
    <GitHubLink prominent />
    <a class="text-link" href="#tutor">
      Start with an AI tutor
    </a>
  </div>
  <TutorStart />
  <figure class="hero-art">
    <picture>
      <source media="(max-width:760px)" srcset={siteUrl('assets/jax-learning-map-mobile.svg')} />
      <img
        src={siteUrl('assets/jax-learning-map.svg')}
        width="640"
        height="420"
        alt="Transform a pure function with grad for derivatives, vmap for batching, and jit for compilation."
      />
    </picture>
    <figcaption>
      <span>One function. Three ways to transform it.</span>
      <span class="map-links">
        <a href={siteUrl('lesson.html?lesson=first-gradient')}>grad</a>
        <a href={siteUrl('lesson.html?lesson=transforms-03')}>vmap</a>
        <a href={siteUrl('lesson.html?lesson=transforms-04')}>jit</a>
      </span>
    </figcaption>
  </figure>
</section>
