---
import '../../styles/home/projects.css';
import { projects } from '../../data/home.json';
import { siteUrl } from '../../lib/urls.js';
import SectionHeading from '../shared/SectionHeading.astro';
---

<section class="project-section" aria-labelledby="projects-title">
  <div class="page-width">
    <SectionHeading id="projects-title" title={projects.title} intro={projects.intro} />
    <div class="project-grid">
      {projects.items.map((project) => (
        <article class="project-tile">
          <div class="project-drawing">
            <img
              src={siteUrl(project.illustration)}
              width="430"
              height="130"
              alt={project.alt}
              loading="lazy"
            />
          </div>
          <div class="project-copy">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <a class="text-link" href={siteUrl(`project.html?id=${project.id}`)}>
              {project.linkLabel}
            </a>
          </div>
        </article>
      ))}
    </div>
    <a class="text-link" href={siteUrl('projects.html')}>
      Browse all projects
    </a>
    <p class="project-scope">{projects.scope}</p>
  </div>
</section>
