---
import PageIntro from '../../components/shared/PageIntro.astro';
import TrackStageCard from '../../components/tracks/TrackStageCard.astro';
import manifest from '../../../curriculum/modality-tracks.json';
import projectPlans from '../../../curriculum/project-plans.json';
import registry from '../../../public/api/v1/projects.json';
import { course } from '../../lib/course-data.js';
import { inlineMath } from '../../lib/math.js';
import { lessonLink, siteUrl } from '../../lib/urls.js';
import { projectFileLayout } from '../../lib/views/project.js';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteFooter from '../../components/shared/SiteFooter.astro';
import '../../styles/tokens.css';
import '../../styles/base.css';
import '../../styles/features/tracks.css';

export function getStaticPaths() {
  return manifest.tracks.map((track) => ({ params: { id: track.id }, props: { track } }));
}
const { track } = Astro.props;
const harnessProject = track.harnessProjectId
  ? registry.projects.find((project) => project.id === track.harnessProjectId)
  : null;
const harnessLayout = harnessProject ? projectFileLayout(harnessProject) : null;
const nextProjects = projectPlans.filter((project) => project.trackIds.includes(track.id));
---

<SiteLayout title={`${track.title} — JAX Pathways`} description={track.summary} active="projects">
  <main id="main" class="track-page">
    <PageIntro
      backHref="projects.html#modality-tracks"
      backLabel="All project guides"
      edition={`${track.status === 'authored' ? 'Runnable project' : 'Guided project plan'} · 8 lifecycle stages`}
      title={track.title}
      intro={track.summary}
    >
      <p class="track-status" set:html={inlineMath(track.available)} />
      {harnessLayout && (
        <div class="project-guide-brief">
          <p class="edition">Where to put your code</p>
          <p>
            <strong>Write your code in:</strong> <code>{harnessLayout.workspaceFile}</code> (copy{' '}
            <code>{harnessLayout.starterFile}</code> first:{' '}
            <code>
              cp {harnessLayout.starterFile} {harnessLayout.workspaceFile}
            </code>
            ).
          </p>
          <p>
            <strong>Verify stages:</strong>{' '}
            <code>
              python3 {harnessLayout.checkerFile} --stage all --impl {harnessLayout.workspaceFile}
            </code>
          </p>
        </div>
      )}
      <div class="actions">
        {track.harnessProjectId && (
          <a class="button primary" href={siteUrl(`project.html?id=${track.harnessProjectId}`)}>
            Open the runnable harness
          </a>
        )}
        <a class="button" href={siteUrl(lessonLink(track.firstLessonId))}>
          Start with the preparation lesson
        </a>
        <a class="button" href={siteUrl(`guides/${track.id}.md`)} download>
          Download guide
        </a>
        <a class="button" href={siteUrl('project-guides/engineering-release.html')}>
          Add tracking, containers and release checks
        </a>
      </div>
    </PageIntro>
    <section class="track-contract" aria-labelledby="target-heading">
      <div>
        <h2 id="target-heading">What you’re working toward</h2>
        <p set:html={inlineMath(track.task)} />
        <h3>Before you start</h3>
        <p set:html={inlineMath(track.prerequisites)} />
      </div>
      <div>
        <h2>How to use this guide</h2>
        <p>
          Follow one stage at a time. Read the linked lesson, predict a result, run its companion,
          then adapt the contract to your project. Keep your observed output and explain a failure
          before moving on.
        </p>
        <p>
          {track.harnessProjectId
            ? 'Use the linked project stages to connect these building blocks. Its reference checks establish the declared CPU fixture; real-data quality and target-device measurements need separate evidence.'
            : 'Preparation links teach a building block. The connected harness for this track remains planned.'}
        </p>
      </div>
    </section>
    <nav class="track-stage-nav" aria-label="Project stages">
      <ol>
        {track.stages.map((stage) => (
          <li>
            <a href={`#${stage.id}`} set:html={inlineMath(stage.title)} />
          </li>
        ))}
      </ol>
    </nav>
    <section class="track-figure" aria-labelledby="figure-heading">
      <h2 id="figure-heading">Make the figures explain the model</h2>
      <p set:html={inlineMath(track.plot)} />
      <p>
        For every figure, name the axes, units, dataset and configuration. Explain one visible
        pattern with actual values, connect it to the mechanism, and state a conclusion the figure
        cannot support.
      </p>
    </section>
    {track.stages.map((stage, index) => (
      <TrackStageCard
        stage={stage}
        index={index}
        totalStages={track.stages.length}
        harnessProjectId={track.harnessProjectId}
      />
    ))}
    {manifest.sharedSections.map((section, index) => (
      <section class="track-stage" aria-labelledby={`shared-${index}`}>
        <h2 id={`shared-${index}`}>{section.title}</h2>
        <p set:html={inlineMath(section.paragraphs[0])} />
        {section.items.length > 0 && (
          <ul>
            {section.items.map((item) => (
              <li set:html={inlineMath(item)} />
            ))}
          </ul>
        )}
        <p set:html={inlineMath(section.paragraphs[1])} />
      </section>
    ))}
    <section class="track-stage" aria-labelledby="reference-heading">
      <h2 id="reference-heading">References and next steps</h2>
      <ul>
        {manifest.references.map((ref) => (
          <li>
            <a href={ref.url}>{ref.title}</a>
          </li>
        ))}
      </ul>
      <div class="actions">
        {track.pathwayIds.map((id) => (
          <a class="button" href={siteUrl(`pathways.html?path=${id}`)}>
            {course.pathways.find((route) => route.id === id)?.title}
          </a>
        ))}
      </div>
      {track.projectIds.map((id) => (
        <p>
          <a href={siteUrl(`project.html?id=${id}`)}>
            Open the {id === track.harnessProjectId ? 'connected harness' : 'preparation project'}
          </a>
        </p>
      ))}
    </section>
    {nextProjects.length > 0 && (
      <section class="track-stage" aria-labelledby="planned-projects-heading">
        <h2 id="planned-projects-heading">Planned extensions</h2>
        <p>
          These project specifications build on this track. Their workspaces and checks are not
          available yet.
        </p>
        <ul>
          {nextProjects.map((project) => (
            <li>
              <a href={siteUrl(`project-plans/${project.id}.html`)}>{project.title}</a> —{' '}
              {project.summary}
            </li>
          ))}
        </ul>
      </section>
    )}
    <SiteFooter />
  </main>
  <script>
    import { initExperience } from '../../scripts/experience.js';
    initExperience();
  </script>
</SiteLayout>
