---
import ModalityTracks from '../components/paths/ModalityTracks.astro';
import ProjectEntryCard from '../components/projects/ProjectEntryCard.astro';
import PageIntro from '../components/shared/PageIntro.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/features/projects.css';
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import pages from '../data/pages.json';
import registry from '../../public/api/v1/projects.json';
import projectPlans from '../../curriculum/project-plans.json';
import { course } from '../lib/course-data.js';
import { siteUrl } from '../lib/urls.js';
const planned = course.phases.filter((phase) => !phase.projectId);
---

<SiteLayout {...pages.projects}>
  <main id="main" class="projects-catalog">
    <PageIntro
      headingId="projects-heading"
      edition="Hands-on verification"
      title="Projects"
      intro="Choose a project, work through its stages, and keep the evidence. Every available project includes starter code, a reference solution, and checks you can run on CPU."
    >
      <p>
        Starting a new repository?{' '}
        <a href={siteUrl('project-workflow.html')}>
          Set up your folders, experiment records and CLI.
        </a>
      </p>
      <div class="actions">
        <a class="button primary" href="#available">
          Available projects
        </a>
        <a class="button" href="#alignment-retrieval">
          CLIP, SigLIP & retrieval plans
        </a>
        {planned.length > 0 && (
          <a class="button" href="#planned">
            Future project briefs
          </a>
        )}
      </div>
    </PageIntro>
    <section id="available" aria-labelledby="available-heading">
      <h2 id="available-heading">Ready to build</h2>
      {registry.projects.map((project) => (
        <ProjectEntryCard project={project} />
      ))}
      <p class="projects-note">
        Passing the public checks is practice evidence. It is not an independently reviewed
        qualification.
      </p>
    </section>
    <ModalityTracks />
    <section id="alignment-retrieval" class="project-roadmap" aria-labelledby="alignment-heading">
      <h2 id="alignment-heading">Next: alignment and retrieval</h2>
      <p>
        Three planned capstones connect model training to search. Read their staged specifications;
        runnable workspaces and measured results are still to come.
      </p>
      <ul>
        {projectPlans.map((project) => (
          <li data-planned-project-id={project.id}>
            <div>
              <p class="edition">Planned capstone</p>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
            </div>
            <a class="button" href={siteUrl(`project-plans/${project.id}.html`)}>
              Read project plan
            </a>
          </li>
        ))}
      </ul>
    </section>
    {planned.length > 0 && (
      <section id="planned" class="project-roadmap" aria-labelledby="planned-heading">
        <h2 id="planned-heading">Future project briefs</h2>
        <p>
          These outcomes are planned. Their project workspaces and checks are not available yet.
        </p>
        <ul>
          {planned.map((phase) => (
            <li>
              <div>
                <h3>{phase.project}</h3>
                <p>{phase.title}</p>
              </div>
              <a
                class="button"
                href={siteUrl(`course.html?phase=${phase.id}&roadmap=1#phase-${phase.id}`)}
              >
                Explore course step
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <SiteFooter />
  </main>
  <script>
    import { initExperience } from '../scripts/experience.js';
    initExperience();
  </script>
</SiteLayout>
