---
import ModalityTracks from '../components/paths/ModalityTracks.astro';
import ProjectEntryCard from '../components/projects/ProjectEntryCard.astro';
import PageIntro from '../components/shared/PageIntro.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/features/projects.css';
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import pages from '../data/pages.json';
import registry from '../../public/api/v1/projects.json';
import projectPlans from '../../curriculum/project-plans.json';
import { course } from '../lib/course-data.js';
import { siteUrl } from '../lib/urls.js';
const planned = course.phases.filter((phase) => !phase.projectId);
const projectGroups = [
  {
    id: 'foundations',
    title: 'Start with foundations',
    paths: ['foundations'],
    note: 'Small audits and shared tools for arrays, transformations and optimization.',
  },
  {
    id: 'models',
    title: 'Train and adapt models',
    paths: ['models'],
    note: 'Training, recovery, experiment lineage and modality harnesses.',
  },
  {
    id: 'research',
    title: 'Explore research domains',
    paths: ['science', 'probability', 'rl', 'internals'],
    note: 'Scientific computing, uncertainty, reinforcement learning and JAX internals.',
  },
  {
    id: 'delivery',
    title: 'Ship and operate workloads',
    paths: ['ship', 'ops'],
    note: 'Interoperability, serving, release controls and operational recovery.',
  },
  {
    id: 'systems',
    title: 'Scale and qualify systems',
    paths: ['scale', 'tpu'],
    note: 'Distributed training, kernels and TPU workflow audits.',
  },
];
const groupedProjects = projectGroups.map((group) => ({
  ...group,
  projects: registry.projects.filter((project) => group.paths.includes(project.pathwayId)),
}));
const ungroupedProjects = registry.projects.filter(
  (project) => !projectGroups.some((group) => group.paths.includes(project.pathwayId)),
);
---

<SiteLayout {...pages.projects}>
  <main id="main" class="projects-catalog">
    <PageIntro
      headingId="projects-heading"
      edition="Hands-on verification"
      title="Projects"
      intro="Choose a project, work through its stages, and keep the evidence. Every available project includes starter code, a reference solution, and checks you can run on CPU."
    >
      <p>
        Runnable projects are practice drafts. Larger model capstones remain planned.
        <a href={siteUrl('content-status.html#projects')}>
          {' '}
          Review their scope and help improve them
        </a>
        .
      </p>
      <p>
        <strong>Recommended first project:</strong> the regression audit. It starts with a small CPU
        fit and independent numerical checks; work at your own pace and keep the outputs as
        evidence.
      </p>
      <div class="actions">
        <a class="button primary" href="#available">
          Available projects
        </a>
        <a class="button" href="#project-regression-audit">
          Start with the regression audit
        </a>
        <a class="button" href="#alignment-retrieval">
          Model lifecycle plans
        </a>
        {planned.length > 0 && (
          <a class="button" href="#planned">
            Future project briefs
          </a>
        )}
      </div>
    </PageIntro>
    <ModalityTracks />
    <section id="available" aria-labelledby="available-heading">
      <h2 id="available-heading">Available practice projects</h2>
      <p>
        Choose a learning stage below. Setup details stay with each project and open when requested.
      </p>
      <nav class="project-filters" aria-label="Filter projects by learning stage">
        <button type="button" data-project-filter="all" aria-pressed="true">
          All ({registry.projects.length})
        </button>
        {groupedProjects
          .filter((group) => group.projects.length)
          .map((group) => (
            <button type="button" data-project-filter={group.id} aria-pressed="false">
              {group.title.replace(
                /^(Start with |Train and adapt |Explore |Ship and operate |Scale and qualify )/,
                '',
              )}{' '}
              ({group.projects.length})
            </button>
          ))}
      </nav>
      {groupedProjects.map(
        (group) =>
          group.projects.length > 0 && (
            <section
              class="project-group"
              data-project-group-section={group.id}
              aria-labelledby={`project-group-${group.id}`}
            >
              <h3 id={`project-group-${group.id}`}>{group.title}</h3>
              <p>{group.note}</p>
              {group.projects.map((project) => (
                <ProjectEntryCard
                  project={project}
                  groupId={group.id}
                  recommended={project.id === 'regression-audit'}
                />
              ))}
            </section>
          ),
      )}
      {ungroupedProjects.map((project) => (
        <ProjectEntryCard project={project} groupId="other" />
      ))}
      <p class="projects-note">
        Passing the public checks is practice evidence. It is not an independently reviewed
        qualification.
      </p>
    </section>
    <section id="alignment-retrieval" class="project-roadmap" aria-labelledby="alignment-heading">
      <h2 id="alignment-heading">Next: complete model lifecycles</h2>
      <p>
        Planned capstones connect text, image, audio and multimodal training to evaluation and
        release. Read their staged specifications; runnable workspaces and measured results are
        still to come.
      </p>
      <ul>
        {projectPlans.map((project) => (
          <li data-planned-project-id={project.id}>
            <div>
              <p class="edition">Planned capstone</p>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
            </div>
            <a class="button" href={siteUrl(`project-plans/${project.id}.html`)}>
              Read project plan
            </a>
          </li>
        ))}
      </ul>
    </section>
    {planned.length > 0 && (
      <section id="planned" class="project-roadmap" aria-labelledby="planned-heading">
        <h2 id="planned-heading">Future project briefs</h2>
        <p>
          These outcomes are planned. Their project workspaces and checks are not available yet.
        </p>
        <ul>
          {planned.map((phase) => (
            <li>
              <div>
                <h3>{phase.project}</h3>
                <p>{phase.title}</p>
              </div>
              <a
                class="button"
                href={siteUrl(`course.html?phase=${phase.id}&roadmap=1#phase-${phase.id}`)}
              >
                Explore course step
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <SiteFooter />
  </main>
  <script>
    import { initExperience } from '../scripts/experience.js';
    import { initProjectCatalog } from '../scripts/catalog.js';
    initExperience();
    initProjectCatalog();
  </script>
</SiteLayout>
