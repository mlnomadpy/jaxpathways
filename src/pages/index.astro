---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import Hero from '../components/home/Hero.astro';
import WorkDirections from '../components/home/WorkDirections.astro';
import LessonPreview from '../components/home/LessonPreview.astro';
import Projects from '../components/home/Projects.astro';
import OfflineReader from '../components/home/OfflineReader.astro';
import pages from '../data/pages.json';
import '../styles/tokens.css';
import '../styles/home/base.css';
---

<SiteLayout {...pages.index}>
  <main id="main">
    <div class="page-width">
      <div id="home-continue" hidden></div>
      <Hero />
      <WorkDirections />
      <LessonPreview />
    </div>
    <Projects />
    <div class="page-width">
      <OfflineReader />
      <SiteFooter />
    </div>
  </main>
  <script>
    import '../scripts/entries/index.js';
  </script>
</SiteLayout>
