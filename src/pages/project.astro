---
import PageIntro from '../components/shared/PageIntro.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/features/project.css';
import SiteLayout from '../layouts/SiteLayout.astro';
import pages from '../data/pages.json';
---

<SiteLayout {...pages.project}>
  <main id="main">
    <section id="project">
      <PageIntro backHref="projects.html" backLabel="All projects" title="Loading project…" />
    </section>
    <SiteFooter />
  </main>
  <script>
    import '../scripts/entries/project.js';
  </script>
</SiteLayout>
