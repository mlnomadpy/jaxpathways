---
import GuideContents from '../../components/shared/GuideContents.astro';
import PageIntro from '../../components/shared/PageIntro.astro';
import GuideLayout from '../../layouts/GuideLayout.astro';
import plans from '../../../curriculum/project-plans.json';
import registry from '../../../public/api/v1/projects.json';
import { allLessons, course } from '../../lib/course-data.js';
import { projectGuide } from '../../lib/server/project-guide.js';
import { lessonLink, siteUrl } from '../../lib/urls.js';
import { projectFileLayout } from '../../lib/views/project.js';

export function getStaticPaths() {
  return plans.map((project) => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const harnessProject = registry.projects.find((item) => item.id === project.harnessId);
const harnessLayout = harnessProject ? projectFileLayout(harnessProject) : null;
const content = projectGuide(
  project,
  course,
  plans.map((plan) => plan.id),
);
---

<GuideLayout
  title={`${project.title} — Project plan`}
  description={project.summary}
  active="projects"
  skipLabel="Skip to project plan"
  mainClass="project-plan"
>
  <PageIntro
    backHref="projects.html#alignment-retrieval"
    backLabel="Alignment and retrieval projects"
    edition="Planned capstone · implementation pending"
    intro={project.summary}
  >
    <Fragment slot="title" set:html={content.heading} />
    <p>
      This specification has no runnable workspace yet. The preparation projects are available now.
    </p>
    {harnessLayout && (
      <div class="project-guide-brief">
        <p class="edition">Where to build your preparation harness now</p>
        <p>
          <strong>Write your code in:</strong> <code>{harnessLayout.workspaceFile}</code> (copy{' '}
          <code>{harnessLayout.starterFile}</code> first:{' '}
          <code>
            cp {harnessLayout.starterFile} {harnessLayout.workspaceFile}
          </code>
          ).
        </p>
        <p>
          <strong>Verify stages:</strong>{' '}
          <code>
            python3 {harnessLayout.checkerFile} --stage all --impl {harnessLayout.workspaceFile}
          </code>
        </p>
      </div>
    )}
    <a class="button primary" href={siteUrl(`project.html?id=${project.harnessId}`)}>
      Start with the runnable harness
    </a>
  </PageIntro>
  <GuideContents sections={content.sections} label="Project plan sections" title="In this plan" />
  <section aria-labelledby="preparation-heading">
    <h2 id="preparation-heading">Available preparation lessons</h2>
    <ul>
      {project.lessonIds.map((id) => (
        <li>
          <a href={siteUrl(lessonLink(id))}>
            {allLessons.find((lesson) => lesson.id === id)?.title}
          </a>
        </li>
      ))}
    </ul>
  </section>
  <article set:html={content.body} />
</GuideLayout>
