---
import GuideContents from '../../components/shared/GuideContents.astro';
import 'katex/dist/katex.min.css';
import '../../styles/tokens.css';
import '../../styles/base.css';
import '../../styles/features/assessment.css';
import '../../styles/features/math.css';
import SiteLayout from '../../layouts/SiteLayout.astro';
import plans from '../../../curriculum/project-plans.json';
import { course } from '../../lib/course-data.js';
import { projectGuide } from '../../lib/server/project-guide.js';
import { siteUrl } from '../../lib/urls.js';
export function getStaticPaths() {
  return plans.map((project) => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const content = projectGuide(
  project,
  course,
  plans.map((plan) => plan.id),
);
const lessons = course.phases.flatMap((phase) => phase.lessons);
---

<SiteLayout
  title={`${project.title} — Project plan`}
  description={project.summary}
  active="projects"
>
  <main id="main" class="project-plan">
    <a href={siteUrl('projects.html#alignment-retrieval')}>Alignment and retrieval projects</a>
    <p class="edition">Planned capstone · implementation pending</p>
    <Fragment set:html={content.heading} />
    <p>{project.summary}</p>
    <p>
      This specification has no runnable workspace yet. The preparation projects are available now.
    </p>
    <a class="button primary" href={siteUrl(`project.html?id=${project.harnessId}`)}>
      Start with the runnable harness
    </a>
    <GuideContents sections={content.sections} label="Project plan sections" title="In this plan" />
    <section aria-labelledby="preparation-heading">
      <h2 id="preparation-heading">Available preparation lessons</h2>
      <ul>
        {project.lessonIds.map((id) => (
          <li>
            <a href={siteUrl(`lesson.html?lesson=${id}`)}>
              {lessons.find((lesson) => lesson.id === id)?.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
    <article set:html={content.body} />
  </main>
</SiteLayout>

<style>
  .project-plan {
    max-width: 860px;
    padding-block: 40px;
    line-height: 1.75;
  }
  .project-plan :global(h1) {
    font: 650 clamp(34px, 6vw, 54px)/1.15 var(--ui);
  }
  .project-plan :global(h2) {
    margin-top: 2.5rem;
    line-height: 1.3;
  }
  .project-plan :global(a:not(.button)) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
