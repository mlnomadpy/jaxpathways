---
import '../styles/features/lesson-list.css';
import PhaseCard from '../components/course/PhaseCard.astro';
import PageIntro from '../components/shared/PageIntro.astro';
import { course, inventory } from '../lib/course-data.js';
import { courseTypeCue } from '../lib/runtime.js';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/features/catalog.css';
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import { lessonLink, siteUrl } from '../lib/urls.js';
import pages from '../data/pages.json';
import assessmentRegistry from '../../curriculum/assessments.json';

const eraOrder = ['era-onboarding', 'era-foundations', 'era-training', 'era-scale', 'era-domains'];
const isOptionalTpu = (phase: { id: string }) =>
  ['tpu', 'tpu-workflows', 'tpu-systems'].includes(phase.id);
const orderedPhases = eraOrder.flatMap((eraId) =>
  course.phases.filter((phase) => !isOptionalTpu(phase) && courseTypeCue(phase).eraId === eraId),
);
const optionalTpuPhases = course.phases.filter(isOptionalTpu);
const filterCounts = Object.fromEntries(
  ['onboarding-tpu', 'foundation', 'training', 'tpu-scale', 'domain'].map((group) => [
    group,
    course.phases.filter((phase) => courseTypeCue(phase).filterGroup === group).length,
  ]),
);
const eraSections = eraOrder
  .filter((eraId) => orderedPhases.some((phase) => courseTypeCue(phase).eraId === eraId))
  .map((eraId) => {
    const phases = orderedPhases.filter((phase) => courseTypeCue(phase).eraId === eraId);
    const firstCue = courseTypeCue(phases[0]);
    return {
      eraId,
      eraTitle: firstCue.eraTitle,
      eraSubtitle: firstCue.eraSubtitle,
      filterGroup: firstCue.filterGroup,
      badge: firstCue.badge,
      phases,
    };
  });
---

<SiteLayout {...pages.course}>
  <main id="main">
    <PageIntro
      edition="Course catalog"
      title="Your route through JAX."
      intro="Open a lesson. Build something you can explain."
    >
      <p id="counts" class="catalog-counts">
        {course.phases.length} phases · {inventory.authored} lessons available
        {inventory.planned ? ` · ${inventory.planned} planned` : ''}
      </p>
      <nav class="course-core-sequence" aria-label="First CPU course steps">
        <a href={siteUrl('lesson-welcome-01.html')}>00 · Set up Python</a>
        <span aria-hidden="true">→</span>
        <a href={siteUrl('course.html?phase=arrays#phase-arrays')}>
          01 · Arrays &amp; pure functions
        </a>
        <span aria-hidden="true">→</span>
        <a href={siteUrl('course.html?phase=transforms#phase-transforms')}>
          02 · JAX transformations
        </a>
      </nav>
    </PageIntro>
    <section id="curriculum">
      <div class="course-access">
        <div>
          <p id="progress" class="soft" aria-live="polite"></p>
          <p>
            Start on CPU setup, continue through foundations and training, then choose a deployment
            or research branch.
          </p>
        </div>
        <div class="actions">
          <a class="button primary" id="course-start" href={siteUrl(lessonLink('welcome-01'))}>
            Start learning
          </a>
          <a href={siteUrl('pathways.html')}>Explore paths</a>
          <a href={siteUrl('projects.html#modality-tracks')}>Connect lessons in a project guide</a>
        </div>
      </div>
      <p class="course-tools-link">
        Starting a project?{' '}
        <a href={siteUrl('project-workflow.html')}>Tools &amp; folder structure</a>.
      </p>
      <div id="path-summary" class="path-summary" hidden></div>
      <div
        id="course-scroll-bar"
        class="course-scroll-bar"
        data-active-era="era-onboarding"
        aria-label="Course section and type filter"
      >
        <div class="course-scroll-status">
          <span class="scroll-kicker">Current section</span>
          <strong id="active-era-indicator">Start Here · CPU Setup</strong>
        </div>
        <div class="course-type-filters" role="group" aria-label="Filter by course type">
          <button
            type="button"
            class="course-filter-btn"
            data-course-filter="all"
            aria-pressed="true"
          >
            All ({course.phases.length})
          </button>
          <button
            type="button"
            class="course-filter-btn"
            data-course-filter="onboarding-tpu"
            aria-pressed="false"
          >
            Setup + TPU ({filterCounts['onboarding-tpu']})
          </button>
          <button
            type="button"
            class="course-filter-btn"
            data-course-filter="foundation"
            aria-pressed="false"
          >
            CPU Foundations ({filterCounts.foundation})
          </button>
          <button
            type="button"
            class="course-filter-btn"
            data-course-filter="training"
            aria-pressed="false"
          >
            Training Systems ({filterCounts.training})
          </button>
          <button
            type="button"
            class="course-filter-btn"
            data-course-filter="tpu-scale"
            aria-pressed="false"
          >
            TPU Scale &amp; Ops ({filterCounts['tpu-scale']})
          </button>
          <button
            type="button"
            class="course-filter-btn"
            data-course-filter="domain"
            aria-pressed="false"
          >
            Research &amp; Domains ({filterCounts.domain})
          </button>
        </div>
      </div>
      <div class="catalog-search-actions">
        <button type="button" class="button" id="course-search-open" aria-haspopup="dialog">
          Search lessons <kbd>/</kbd>
        </button>
        <button type="button" class="button" id="course-search-clear" hidden>
          Clear search
        </button>
      </div>
      <dialog
        id="course-search-dialog"
        class="course-search-dialog"
        aria-labelledby="course-search-title"
      >
        <form method="dialog" class="course-search-form">
          <div class="course-search-heading">
            <div>
              <p class="edition">Course search</p>
              <h2 id="course-search-title">Find a lesson or concept</h2>
            </div>
            <button type="submit" class="course-search-close" aria-label="Close search">
              ×
            </button>
          </div>
          <label for="course-search-input">Search lesson explanations, code and practice</label>
          <input
            id="course-search-input"
            type="search"
            autocomplete="off"
            placeholder="Try “checkpoint”, “vmap” or an error message"
          />
          <p class="course-search-hint">Press Enter to apply · Escape to close</p>
          <div class="actions">
            <button type="button" class="button primary" id="course-search-apply">
              Show matches
            </button>
            <button type="button" class="button" id="course-search-cancel">
              Cancel
            </button>
          </div>
        </form>
      </dialog>
      <p id="course-view-status" class="edition" aria-live="polite"></p>
      <div id="phases" class="phase-grid">
        {eraSections.map((era, eraIdx) => (
          <Fragment>
            <div
              id={era.eraId}
              class="course-era-banner"
              data-era-banner={era.eraId}
              data-era-title={era.eraTitle}
              data-era-group={era.filterGroup}
            >
              <div class="era-banner-top">
                <span class="era-step-badge">
                  Section {eraIdx + 1} of {eraSections.length}
                </span>
                <span class="era-count-badge">{era.phases.length} courses</span>
              </div>
              <p class="era-heading">{era.eraTitle}</p>
              <p class="era-subtitle">{era.eraSubtitle}</p>
            </div>
            {era.phases.map((phase) => (
              <PhaseCard phase={phase} />
            ))}
          </Fragment>
        ))}
        <details class="optional-tpu-track" id="optional-tpu-track">
          <summary>Optional Cloud TPU specialization · 3 steps · 6 lessons</summary>
          <div class="tpu-track-banner" aria-labelledby="tpu-course-title">
            <div>
              <span class="course-type-pill" data-course-kind="tpu-core">
                Optional accelerator branch
              </span>
              <h2 id="tpu-course-title">Qualify a TPU workflow when you need it</h2>
              <p>
                Work through provisioning, checkpointed jobs and TPU system profiling after the
                laptop CPU foundations. Cloud access is not needed for the core course.
              </p>
              <div class="actions">
                <a class="button" href={siteUrl('pathways.html?path=tpu')}>
                  TPU learning path
                </a>
              </div>
            </div>
          </div>
          {optionalTpuPhases.map((phase) => (
            <PhaseCard phase={phase} />
          ))}
        </details>
      </div>
      <details class="course-jump-disclosure">
        <summary>Jump to a course step</summary>
        <div class="course-jumps" id="course-jumps"></div>
      </details>
      <div class="availability-controls" hidden={!inventory.planned}>
        <label class="roadmap-toggle">
          <input type="checkbox" id="show-roadmap" /> Show planned topics
        </label>
      </div>
      <p id="content-status" class="soft">
        {inventory.authored} authored lessons with CPU companions
        {inventory.planned ? ` · ${inventory.planned} topics planned` : ''} ·{' '}
        {course.projectIds.length} staged projects · {assessmentRegistry.length} synthesis
        assessments
      </p>
      <p id="empty" hidden>
        No available lessons in this view.
      </p>
    </section>
    <SiteFooter />
  </main>
  <script>
    import '../scripts/entries/course.js';
  </script>
</SiteLayout>
