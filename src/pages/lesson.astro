---
import '../styles/features/lesson-visuals.css';
import 'katex/dist/katex.min.css';
import '../styles/features/math.css';
import '../styles/features/lesson-list.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/features/reader.css';
import '../styles/features/project.css';
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import pages from '../data/pages.json';
---

<SiteLayout {...pages.lesson}>
  <main id="lesson-page" class="reader-layout">
    <button id="reader-menu" aria-controls="reader-sidebar" aria-expanded="false">
      Lesson list
    </button>
    <aside id="reader-sidebar" class="reader-sidebar" aria-label="Lesson navigation">
      <p id="reader-route" class="edition"></p>
      <h2 id="reader-phase-title"></h2>
      <details class="reader-phases">
        <summary>Other course steps</summary>
        <nav id="reader-phases" aria-label="Course steps"></nav>
      </details>
      <nav id="reader-lessons" aria-label="Phase lessons"></nav>
      <p class="soft">
        Drafts contain teaching material. Unwritten entries show roadmap status only.
      </p>
      <button class="close">Back to course</button>
    </aside>
    <article id="lesson-body">
      <h1>Loading lesson…</h1>
    </article>
    <aside class="reader-outline">
      <details id="reader-outline-disclosure" open>
        <summary>On this page</summary>
        <nav id="reader-toc" aria-label="On this page"></nav>
      </details>
    </aside>
  </main>
  <SiteFooter />
  <script>
    import '../scripts/entries/lesson.js';
  </script>
</SiteLayout>
