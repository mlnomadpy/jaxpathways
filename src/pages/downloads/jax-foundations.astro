---
import { materialStatus, materialStatusLabel } from '../../lib/material-status.js';
import { course, authoredLessons } from '../../lib/course-data.js';
import { readerStyles } from '../../lib/server/reader-styles.js';
import ReaderChapter from '../../components/shared/ReaderChapter.astro';
import { readFileSync } from 'node:fs';
import { inlineMath } from '../../lib/math.js';
import { bookGuide } from '../../lib/server/book-guides.js';
import { pageSeo, bookSchema, bookDescription } from '../../lib/server/seo.js';
import { siteUrl } from '../../lib/urls.js';
import { editionUrl } from '../../lib/releases.js';
import releaseNotes from '../../../curriculum/releases.json';
const release = releaseNotes[0];
const bookUrl = new URL(siteUrl('book.html'), Astro.site);
const readerUrl = new URL(siteUrl('downloads/jax-foundations.html'), Astro.site);
const bookMetadata = pageSeo({
  title: 'JAX Pathways: illustrated course reader',
  description: bookDescription,
  canonical: readerUrl,
  site: Astro.site,
  structuredData: bookSchema(Astro.site),
}).graph;
const online = (path: string) => new URL(path, 'https://www.tahabouhsine.com/jaxpathways/').href;
const practicalGuide = readFileSync(
  new URL('../../../content/guides/project-workflow.md', import.meta.url),
  'utf8',
);
const experimentsWorkshop = readFileSync(
  new URL('../../../projects/reproducible-experiments/README.md', import.meta.url),
  'utf8',
);
const transformerLineage = readFileSync(
  new URL('../../../projects/posttraining-audit/transformer_lineage/TEACHING.md', import.meta.url),
  'utf8',
);
const guideMarkup = (_source: string, sourceFile: string | URL) =>
  bookGuide(sourceFile, course)
    .replace(
      /<table>/g,
      '<div class="reader-table-scroll" role="region" aria-label="Scrollable reference table" tabindex="0"><table>',
    )
    .replace(/<\/table>/g, '</table></div>');
const phases = course.phases
  .map((phase) => ({
    ...phase,
    lessons: phase.lessons.filter((lesson) => lesson.status === 'authored'),
  }))
  .filter((phase) => phase.lessons.length);
const chapterIndex = new Map(authoredLessons.map((lesson, index) => [lesson.id, index]));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>JAX Pathways: illustrated course reader</title>
    <style is:inline set:html={readerStyles} />
    <meta name="robots" content="noindex,follow" />
    <meta name="description" content={bookDescription} />
    <meta name="author" content="Taha Bouhsine" />
    <link rel="canonical" href={readerUrl.href} />
    <meta property="og:type" content="book" />
    <meta property="og:title" content="JAX Pathways: illustrated course reader" />
    <meta property="og:description" content={bookDescription} />
    <meta property="og:url" content={readerUrl.href} />
    <meta
      property="og:image"
      content={new URL(siteUrl('assets/social-card.png'), Astro.site).href}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(bookMetadata).replace(/</g, '\\u003c')}
    />
  </head>
  <body>
    <header class="book-cover">
      <p class="chapter-kicker">
        JAX Pathways · Course reader · v{release.version} · {release.date}
      </p>
      <h1>
        Understand the math.
        <br />
        Build the system.
      </h1>
      <p>
        By Taha Bouhsine · <a href={bookUrl.href}>Book overview and current edition</a>
      </p>
      <p class="book-description">
        Worked explanations, executable examples and evidence you can inspect.
      </p>
      <p class="reader-actions">
        <a href="#chapter-0">Start reading</a>
        <a href="#book-contents">Browse chapters</a>
      </p>
    </header>
    <p class="reader-intro">
      {authoredLessons.length} lessons ·{' '}
      <a href={online('content-status.html#book-reader')}>In development</a>. Read the explanation,
      make a prediction, then try the exercise before opening its answer.
    </p>
    <details class="reading-disclosure reader-introduction">
      <summary>About this book and how to use it</summary>
      <div class="disclosure-body">
        <p>
          {authoredLessons.length} authored lessons from the shared course. Reference execution
          status is recorded separately in validation.json. Bounded physical v5e target receipts
          qualify their named experiments only; independent teaching review is still pending. The
          book is in development.{' '}
          <a href={online('content-status.html#book-reader')}>
            Check scope and contribution priorities
          </a>
          .
        </p>
        <p>
          Follow the phases in order when you are new to JAX. Each phase guide states what to
          prepare, what to build, and what evidence to keep. Exercises and checkpoints are practice;
          project completion and reviewed competency are separate. Try each task before opening its
          answer.
        </p>
        <p>
          <a href={editionUrl(release.version)}>Read this edition’s changes online</a>
        </p>
      </div>
    </details>
    <details class="reading-disclosure book-routes">
      <summary>Choose a different learning route</summary>
      <nav aria-label="Choose a learning route">
        <h2>Choose a route</h2>
        <ul>
          {course.pathways.map((route) => (
            <li>
              <a href={online(`course.html?path=${encodeURIComponent(route.id)}`)}>{route.title}</a>{' '}
              · {route.description}
            </li>
          ))}
        </ul>
        <p>
          Career routes and their milestones are available in the{' '}
          <a href={online('careers.html')}>online career guide</a>.
        </p>
      </nav>
    </details>
    <nav aria-label="Book chapters" id="book-contents">
      <h2>Contents</h2>
      <ol>
        {phases.map((phase) => (
          <li>
            <details class="book-toc-phase">
              <summary>
                Phase {phase.number}: {phase.title}
              </summary>
              <p>
                <a href={`#phase-${phase.id}`}>Read phase overview</a>
              </p>
              <ol>
                {phase.lessons.map((lesson) => (
                  <li>
                    <a href={`#chapter-${chapterIndex.get(lesson.id)}`}>{lesson.title}</a>
                  </li>
                ))}
              </ol>
            </details>
          </li>
        ))}
        <li>
          <a href="#appendix-project-workflow">Appendix: project structure and evidence</a>
        </li>
        <li>
          <a href="#appendix-experiments">Appendix: reproducible experiments workshop</a>
        </li>
        <li>
          <a href="#appendix-posttraining-lineage">Optional appendix: saved-decoder sequence PPO</a>
        </li>
      </ol>
    </nav>
    <main>
      {phases.map((phase) => (
        <section class="book-phase" id={`phase-${phase.id}`}>
          <p class="chapter-kicker">Phase {phase.number}</p>
          <h1>{phase.title}</h1>
          <p class="chapter-kicker">
            <a href={online(`content-status.html#phases-${phase.id}`)}>
              {materialStatusLabel(materialStatus('phases', phase.id).level)}
            </a>{' '}
            · Teaching review pending.
          </p>
          {phase.studyGuide && (
            <>
              <h2>Phase question</h2>
              <p set:html={inlineMath(phase.studyGuide.question)} />
              <p set:html={inlineMath(phase.studyGuide.why)} />
            </>
          )}
          <details class="reading-disclosure phase-plan">
            <summary>Phase plan, checkpoints and project</summary>
            <div class="disclosure-body">
              {phase.studyGuide && (
                <>
                  <h2>Prepare and work through the phase</h2>
                  <ol>
                    {phase.studyGuide.milestones.map((milestone) => (
                      <li>
                        <h3>{milestone.title}</h3>
                        <p set:html={inlineMath(milestone.task)} />
                      </li>
                    ))}
                  </ol>
                  <h2>Readiness check</h2>
                  <p set:html={inlineMath(phase.studyGuide.readiness.prompt)} />
                  <details>
                    <summary>Compare your reasoning</summary>
                    <p set:html={inlineMath(phase.studyGuide.readiness.answer)} />
                  </details>
                  <h2>Transfer question</h2>
                  <p set:html={inlineMath(phase.studyGuide.transfer.prompt)} />
                  <details>
                    <summary>Compare your approach</summary>
                    <p set:html={inlineMath(phase.studyGuide.transfer.approach)} />
                  </details>
                  <h2>Common pitfall</h2>
                  <p>
                    <strong>{phase.studyGuide.pitfall.symptom}</strong>{' '}
                    {phase.studyGuide.pitfall.check}
                  </p>
                  <h2>Phase artifact</h2>
                  <p set:html={inlineMath(phase.studyGuide.completion)} />
                  <p set:html={inlineMath(phase.studyGuide.furtherWork)} />
                </>
              )}
              <p>
                <strong>Phase project:</strong> {phase.project}. {phase.checkpoint}
                {phase.projectStageIds?.length && (
                  <span>
                    {' '}
                    Start with project stage{phase.projectStageIds.length === 1 ? '' : 's'}{' '}
                    {phase.projectStageIds.join(', ')}.
                  </span>
                )}
              </p>
              {phase.projectId && (
                <p>
                  <a href={online(`project.html?id=${encodeURIComponent(phase.projectId)}`)}>
                    Open phase project workspace
                  </a>{' '}
                  ·{' '}
                  <a href={online(`project-guides/${encodeURIComponent(phase.projectId)}.html`)}>
                    Read project guide and figures
                  </a>
                </p>
              )}
              {phase.additionalProjectIds?.map((id) => (
                <p>
                  <a href={online(`project.html?id=${encodeURIComponent(id)}`)}>
                    Optional project: {id}
                  </a>
                </p>
              ))}
            </div>
          </details>
          {phase.lessons.map((lesson) => (
            <ReaderChapter lesson={lesson} index={chapterIndex.get(lesson.id)!} offline />
          ))}
        </section>
      ))}
      <section id="appendix-project-workflow">
        <h1>Appendix: project structure and evidence</h1>
        <p>
          This practical guide explains how to place learner code, run checks, save evidence, and
          diagnose common workflow failures. The full guide is also available{' '}
          <a href={online('project-workflow.html')}>online</a>.
        </p>
        <Fragment
          set:html={guideMarkup(
            practicalGuide,
            new URL('../../../content/guides/project-workflow.md', import.meta.url).pathname,
          )}
        />
      </section>
      <section id="appendix-experiments">
        <h1>Appendix: reproducible experiments workshop</h1>
        <p>
          The workshop turns a question into frozen configuration and data, paired runs, recorded
          failures and retries, plots, and a research notebook. Its staged workspace and figures are
          available <a href={online('project-guides/reproducible-experiments.html')}>online</a>.
        </p>
        <Fragment
          set:html={guideMarkup(
            experimentsWorkshop,
            new URL('../../../projects/reproducible-experiments/README.md', import.meta.url)
              .pathname,
          )}
        />
      </section>
      <section id="appendix-posttraining-lineage">
        <h1>Optional appendix: a saved decoder enters sequence PPO</h1>
        <p>
          This appendix is separate from registered Stage 5. Independent review accepted its
          mechanics and replay checks, but the strict heldout reward quality floor failed. It does
          not establish language-model quality. The optional extension and its evidence are
          available{' '}
          <a href={online('project-guides/posttraining-transformer-lineage.html')}>online</a>.
        </p>
        <Fragment
          set:html={guideMarkup(
            transformerLineage,
            new URL(
              '../../../projects/posttraining-audit/transformer_lineage/TEACHING.md',
              import.meta.url,
            ),
          )}
        />
      </section>
    </main>
    <script is:inline>
      const readerPrintExpanded = new Set();
      const expandReaderReasoningForPrint = () => {
        for (const details of document.querySelectorAll('details:not(.solution-reveal)')) {
          if (details.open) continue;
          details.open = true;
          readerPrintExpanded.add(details);
        }
      };
      const restoreReaderReasoningAfterPrint = () => {
        for (const details of readerPrintExpanded) details.open = false;
        readerPrintExpanded.clear();
      };
      window.addEventListener('beforeprint', expandReaderReasoningForPrint);
      window.addEventListener('afterprint', restoreReaderReasoningAfterPrint);
      window.matchMedia?.('print').addEventListener?.('change', (event) => {
        if (event.matches) expandReaderReasoningForPrint();
        else restoreReaderReasoningAfterPrint();
      });
      document.documentElement.dataset.readerReady = 'true';
      document.addEventListener('click', async (event) => {
        const button = event.target.closest('.copy-snippet');
        if (!button) return;
        const panel = button.closest('.code-panel');
        const code = panel.querySelector('pre code');
        const feedback = panel.querySelector('.copy-feedback');
        try {
          await navigator.clipboard.writeText(code.textContent);
          feedback.textContent = 'Copied code.';
        } catch {
          const range = document.createRange();
          range.selectNodeContents(code);
          const selection = window.getSelection();
          selection.removeAllRanges();
          selection.addRange(range);
          feedback.textContent = 'Code selected. Press Ctrl+C or Command+C to copy.';
        }
      });
    </script>
  </body>
</html>
