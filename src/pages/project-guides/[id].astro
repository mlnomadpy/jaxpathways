---
import GuideContents from '../../components/shared/GuideContents.astro';
import PageIntro from '../../components/shared/PageIntro.astro';
import GuideLayout from '../../layouts/GuideLayout.astro';
import registry from '../../../public/api/v1/projects.json';
import { course } from '../../lib/course-data.js';
import { inlineMath } from '../../lib/math.js';
import { projectGuide } from '../../lib/server/project-guide.js';
import { siteUrl } from '../../lib/urls.js';
import { projectFileLayout } from '../../lib/views/project.js';

export function getStaticPaths() {
  return registry.projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const content = projectGuide(project, course);
const layout = projectFileLayout(project);
---

<GuideLayout
  title={`${project.title} — JAX Pathways`}
  description={project.rubric[0]}
  active="projects"
  skipTarget="#assessment"
  skipLabel="Skip to project guide"
  mainClass="project-guide"
>
  <PageIntro
    backHref="projects.html"
    backLabel="All projects"
    edition={`Project guide · ${project.hardware}`}
  >
    <Fragment slot="title" set:html={content.heading} />
    <p set:html={inlineMath(project.setupNote)} />
    <div class="assessment-actions">
      <a class="button primary" href={siteUrl(`project.html?id=${project.id}`)}>
        Open stage workspace
      </a>
      <a class="button" href={siteUrl(`downloads/${project.id}.zip`)} download>
        Download code and evidence
      </a>
    </div>
  </PageIntro>
  <aside class="project-guide-brief" aria-label="Workspace and code placement">
    <p class="edition">Where to put your code &amp; how to run checks</p>
    <p>
      {layout.copiesStarter ? (
        <Fragment>
          Copy the starter template <code>{layout.starterFile}</code> into{' '}
          <strong>
            <code>{layout.workspaceFile}</code>
          </strong>{' '}
          and write all of your code in <code>{layout.workspaceFile}</code>.
        </Fragment>
      ) : (
        <Fragment>
          Open{' '}
          <strong>
            <code>{layout.workspaceFile}</code>
          </strong>{' '}
          in your editor and implement the functions marked with <code>NotImplementedError</code>.
        </Fragment>
      )}{' '}
      Run <code>{layout.checkerFile}</code> from the extracted top folder after each of the{' '}
      {project.stages.length} stages.
    </p>
  </aside>
  <GuideContents sections={content.sections} label="Project guide sections" title="In this guide" />
  <article set:html={content.body} />
  <a class="button primary" href={siteUrl(`project.html?id=${project.id}`)}>
    Build and check your implementation
  </a>
</GuideLayout>
