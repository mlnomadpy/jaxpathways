---
import AssessmentActions from '../../components/shared/AssessmentActions.astro';
import GuideContents from '../../components/shared/GuideContents.astro';
import MaterialStatus from '../../components/shared/MaterialStatus.astro';
import PageIntro from '../../components/shared/PageIntro.astro';
import GuideLayout from '../../layouts/GuideLayout.astro';
import assessments from '../../../curriculum/assessments.json';
import { assessmentContent } from '../../lib/server/assessment-content.js';

export function getStaticPaths() {
  return assessments.map((assessment) => ({
    params: { id: assessment.id },
    props: { assessment },
  }));
}
const { assessment } = Astro.props;
const content = assessmentContent(assessment.source);
---

<GuideLayout
  title={`${assessment.title} — JAX Pathways`}
  description={assessment.description}
  active="course"
  skipTarget="#assessment"
  skipLabel="Skip to assessment"
>
  <PageIntro
    backHref="course.html"
    backLabel="Course"
    edition="Synthesis assessment · CPU & changed-condition verification"
  >
    <Fragment slot="title" set:html={content.heading} />
    <AssessmentActions assessment={assessment} />
  </PageIntro>
  <MaterialStatus kind="assessments" id={assessment.id} />
  <GuideContents
    sections={content.sections}
    label="Assessment sections"
    title="In this assessment"
  />
  <article set:html={content.body} />
  <AssessmentActions assessment={assessment} />
  <p class="soft">
    Complete each task with changed inputs, independent numerical checks, and saved terminal outputs
    in your portfolio.
  </p>
</GuideLayout>
