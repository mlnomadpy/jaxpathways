---
import '../styles/features/releases.css';
import '../styles/features/material-status.css';
import ReleaseNotice from '../components/shared/ReleaseNotice.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import { siteUrl } from '../lib/urls.js';
import { pageSeo } from '../lib/server/seo.js';
interface Props {
  title: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
  description: string;
  bodyClass?: string;
  active?: string;
  skipTarget?: string;
  skipLabel?: string;
}
const {
  title,
  noindex = false,
  structuredData,
  description,
  bodyClass,
  active,
  skipTarget = '#main',
  skipLabel = 'Skip to content',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || 'https://www.tahabouhsine.com');
if (canonical.pathname.endsWith('/index.html'))
  canonical.pathname = canonical.pathname.slice(0, -10);
const { graph: jsonLd, crumbs } = pageSeo({
  title,
  description,
  canonical,
  site: Astro.site,
  structuredData,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('jaxpathways-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {}
      })();
    </script>
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="author" content="Taha Bouhsine" />
    <meta
      property="og:type"
      content={
        Astro.url.pathname.includes('lesson-')
          ? 'article'
          : Astro.url.pathname.endsWith('/book.html')
            ? 'book'
            : 'website'
      }
    />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="JAX Pathways" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta
      property="og:image"
      content={new URL(siteUrl('assets/social-card.png'), Astro.site).href}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="JAX Pathways — Learn, build, explain. A practical course by Taha Bouhsine."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL(siteUrl('assets/social-card.png'), Astro.site).href}
    />
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
      />
    )}
    <link rel="icon" type="image/svg+xml" href={siteUrl('assets/pathway-mark.svg')} />
  </head>
  <body class={bodyClass}>
    <a class="skip" href={skipTarget}>
      {skipLabel}
    </a>
    <SiteHeader active={active} />
    <ReleaseNotice />
    {!noindex && crumbs.length > 0 && (
      <nav class="seo-breadcrumb" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((crumb, index) => (
            <li>
              {index === crumbs.length - 1 ? (
                <span aria-current="page">{crumb.name}</span>
              ) : (
                <a href={crumb.url}>{crumb.name}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <slot />
  </body>
</html>

<style>
  .seo-breadcrumb {
    max-width: 1320px;
    margin: 16px auto;
    padding-inline: 5%;
    font: 13px/1.6 var(--ui);
    color: var(--muted);
  }
  .seo-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .seo-breadcrumb li + li::before {
    content: '/';
    margin-right: 6px;
  }
</style>
