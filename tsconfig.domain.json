    "src/lib/html.js",
    "src/lib/http.js",
    "src/lib/learner-records.js",
    "src/lib/lesson-content.js",
    "src/lib/lesson-template.js",
    "src/lib/lesson-visuals.js",
    "src/lib/manifests.js",
    "src/lib/math.js",
    "src/lib/practice-content.js",
    "src/lib/releases.js",
    "src/lib/runtime.js",
    "src/lib/schedule.js",
    "src/lib/search.js",
    "src/lib/storage.js",
    "src/lib/urls.js",
    "src/lib/views/career.js",
    "src/lib/views/domains.js",
